# Core
NODE_ENV=development
DATABASE_URL=postgresql://receiptbrain:receiptbrain@localhost:5432/receiptbrain?schema=public
REDIS_URL=redis://localhost:6379

# Storage (MinIO local)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=receiptbrain
S3_ACCESS_KEY=receiptbrain
S3_SECRET_KEY=receiptbrain-secret
S3_FORCE_PATH_STYLE=true

# AI service (internal)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=dev-internal-token-change-me

# OpenAI
OPENAI_API_KEY=sk-proj-key-1234567890
OPENAI_MODEL_EXTRACT=gpt-4o
OPENAI_MODEL_RECOMMEND=gpt-4o-mini

# Auth (NextAuth.js)
NEXTAUTH_SECRET=dev-secret-change-me-must-be-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000
RESEND_API_KEY=re_...
AUTH_EMAIL_FROM=ReceiptBrain <noreply@example.com>
# Optional: Google OAuth (https://console.cloud.google.com/apis/credentials)
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# Limits
MAX_UPLOAD_MB=10
