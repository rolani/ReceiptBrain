{
  "name": "receiptbrain",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev --parallel",
    "tunnel": "bash scripts/run-cloudflare-tunnel.sh",
    "tunnel:setup": "bash scripts/setup-cloudflare-tunnel.sh",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "rimraf": "6.0.1",
    "turbo": "2.9.14",
    "typescript": "5.6.3"
  }
}
