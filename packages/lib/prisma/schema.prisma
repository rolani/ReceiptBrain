// ReceiptBrain database schema.
// - Money fields use Decimal(12, 2) — never Float (rule: prisma-database.mdc).
// - All models carry createdAt + updatedAt.
// - Receipts are soft-deletable; everything else is hard-deleted via cascade.
// - Indexes target the access patterns from outline.md (per-user queries, dedup).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  /// User override for insight currency; falls back to DEFAULT_CURRENCY env.
  defaultCurrency          String? @db.Char(3)
  /// User override for insight location label; falls back to DEFAULT_LOCATION env.
  defaultLocation          String?
  /// ISO-3166 alpha-2; falls back to DEFAULT_LOCATION_COUNTRY env.
  defaultLocationCountry   String? @db.Char(2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  receipts      Receipt[]
  subscriptions Subscription[]
  insights      Insight[]
  accounts      Account[]
  sessions      Session[]
}

// NextAuth.js v5 + @auth/prisma-adapter required models.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Merchant {
  id            String  @id @default(cuid())
  canonicalName String  @unique
  category      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipts      Receipt[]
  subscriptions Subscription[]
}

model Receipt {
  id              String        @id @default(cuid())
  userId          String
  merchantId      String?
  rawMerchant     String?
  imageUrl        String
  imageHash       String
  imageMime       String
  imageBytes      Int
  status          ReceiptStatus @default(uploaded)
  total           Decimal?      @db.Decimal(12, 2)
  subtotal        Decimal?      @db.Decimal(12, 2)
  tax             Decimal?      @db.Decimal(12, 2)
  tip             Decimal?      @db.Decimal(12, 2)
  currency        String?
  purchasedAt     DateTime?
  paymentLast4    String?
  fieldConfidence Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  items       Item[]
  extractions ExtractionAttempt[]
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant    Merchant?           @relation(fields: [merchantId], references: [id])

  @@unique([userId, imageHash])
  @@index([userId, purchasedAt])
  @@index([userId, status])
  @@index([merchantId])
}

enum ReceiptStatus {
  uploaded
  extracting
  extracted
  failed
  needs_review
}

model Item {
  id         String        @id @default(cuid())
  receiptId  String
  lineNumber Int
  name       String
  unitPrice  Decimal       @db.Decimal(12, 2)
  quantity   Int           @default(1)
  lineTotal  Decimal       @db.Decimal(12, 2)
  category   ItemCategory?
  confidence Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@unique([receiptId, lineNumber])
  @@index([receiptId])
}

enum ItemCategory {
  groceries
  dining
  transport
  software
  entertainment
  utilities
  household
  health
  travel
  other
}

model Subscription {
  id                 String               @id @default(cuid())
  userId             String
  merchantId         String
  amount             Decimal              @db.Decimal(12, 2)
  currency           String
  interval           SubscriptionInterval
  firstCharge        DateTime
  lastCharge         DateTime
  nextChargeEstimate DateTime?
  confidence         Float
  status             SubscriptionStatus   @default(active)
  sourceReceiptIds   String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@unique([userId, merchantId, interval])
  @@index([userId, status])
  @@index([merchantId])
}

enum SubscriptionInterval {
  weekly
  monthly
  quarterly
  yearly
}

enum SubscriptionStatus {
  active
  paused
  cancelled
  unconfirmed
}

model Insight {
  id                   String        @id @default(cuid())
  userId               String
  type                 InsightType
  title                String
  description          String
  estimatedSavings     Decimal?      @db.Decimal(12, 2)
  currency             String?
  action               Json?
  status               InsightStatus @default(new)
  sourceReceiptIds     String[]
  sourceSubscriptionId String?
  modelVersion         String?
  promptVersion        String?
  contentFingerprint   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentFingerprint])
  @@index([userId, type, status])
  @@index([userId, status, createdAt])
}

enum InsightType {
  cheaper_alternative
  subscription_waste
  spending_spike
  optimization_tip
}

enum InsightStatus {
  new
  seen
  dismissed
  actioned
}

// Raw + normalized extraction history per receipt. Lets us reprocess when
// prompts/models improve, debug failures, and track AI cost.
model ExtractionAttempt {
  id               String           @id @default(cuid())
  receiptId        String
  modelName        String
  promptVersion    String
  rawJson          Json
  status           ExtractionStatus
  errorMessage     String?
  promptTokens     Int?
  completionTokens Int?
  costUsdEstimate  Decimal?         @db.Decimal(10, 4)
  durationMs       Int?

  createdAt DateTime @default(now())

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId, createdAt])
}

enum ExtractionStatus {
  success
  partial
  failed
}
