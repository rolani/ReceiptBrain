{
  "name": "@receiptbrain/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "dev": "dotenv -e ../../.env -- next dev --port 3000",
    "build": "NODE_ENV=production dotenv -e ../../.env -- next build",
    "start": "NODE_ENV=production dotenv -e ../../.env -- next start",
    "lint": "next lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf .next .turbo coverage"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2",
    "@receiptbrain/contracts": "workspace:*",
    "@receiptbrain/lib": "workspace:*",
    "@receiptbrain/ui": "workspace:*",
    "@t3-oss/env-nextjs": "0.11.1",
    "@tanstack/react-query": "5",
    "next": "15.1.3",
    "next-auth": "5.0.0-beta.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7",
    "resend": "4",
    "zod": "3.23.8",
    "zustand": "5"
  },
  "devDependencies": {
    "@playwright/test": "1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "dotenv-cli": "7",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.3",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "rimraf": "6.0.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
